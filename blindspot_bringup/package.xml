<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>blindspot_bringup</name>
  <version>0.0.0</version>
  <description>Launch the LiDAR, camera and static transforms of the sensor jig</description>
  <maintainer email="dev.immme@gmail.com">immme</maintainer>
  <license>AGPL-3.0-only</license>

  <depend>launch</depend>
  <depend>launch_ros</depend>

  <exec_depend>sllidar_ros2</exec_depend>
  <exec_depend>v4l2_camera</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
